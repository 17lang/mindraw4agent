{
  "name": "mindraw4agent",
  "version": "0.2.0",
  "private": true,
  "description": "Read Mindraw Frame links as text, annotations and PNG through the App API; open project canvases.",
  "license": "MIT",
  "author": {
    "name": "张军锋"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/17lang/mindraw4agent.git"
  },
  "bugs": {
    "url": "https://github.com/17lang/mindraw4agent/issues"
  },
  "homepage": "https://github.com/17lang/mindraw4agent#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check scripts/doctor.mjs && npm run --prefix plugins/mindraw check",
    "smoke": "npm run --prefix plugins/mindraw smoke",
    "smoke:http": "npm run --prefix plugins/mindraw smoke:http",
    "smoke:lifecycle": "npm run --prefix plugins/mindraw smoke:lifecycle",
    "smoke:mcp": "npm run --prefix plugins/mindraw smoke:mcp",
    "smoke:sidebar": "npm run --prefix plugins/mindraw smoke:sidebar",
    "doctor": "node scripts/doctor.mjs",
    "test:frame": "node --test plugins/mindraw/test/frame-read.test.mjs"
  }
}
